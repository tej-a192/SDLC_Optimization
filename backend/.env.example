# ============================================================
# SDLC Optimization Backend — Environment Variables
# ============================================================

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# ── LLM Provider Selection ──
# Options: "openai", "gemini", "ollama"
LLM_PROVIDER=gemini

# ── OpenAI ──
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# ── Google Gemini (1M context) ──
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# ── Ollama (local) ──
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── RAG Service ──
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE=chroma
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── Paths ──
PROJECTS_DIR=../PROJECTS
