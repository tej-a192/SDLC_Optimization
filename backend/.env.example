# ============================================================
# SDLC Optimization Backend — Environment Variables
# ============================================================

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# ── LLM Provider Selection ──
# Options: "openai", "gemini", "ollama"
LLM_PROVIDER=gemini

# ── Google Gemini API Keys (up to 9, round-robin rotation) ──
GEMINI_API_KEY_1=your-gemini-key-1
GEMINI_API_KEY_2=your-gemini-key-2
GEMINI_API_KEY_3=your-gemini-key-3
GEMINI_API_KEY_4=your-gemini-key-4
GEMINI_API_KEY_5=your-gemini-key-5
GEMINI_API_KEY_6=your-gemini-key-6
GEMINI_API_KEY_7=your-gemini-key-7
GEMINI_API_KEY_8=your-gemini-key-8
GEMINI_API_KEY_9=your-gemini-key-9
GEMINI_MODEL=gemini-2.0-flash

# ── OpenAI API Keys (up to 9, round-robin rotation) ──
OPENAI_API_KEY_1=your-openai-key-1
OPENAI_API_KEY_2=your-openai-key-2
OPENAI_API_KEY_3=your-openai-key-3
OPENAI_API_KEY_4=your-openai-key-4
OPENAI_API_KEY_5=your-openai-key-5
OPENAI_API_KEY_6=your-openai-key-6
OPENAI_API_KEY_7=your-openai-key-7
OPENAI_API_KEY_8=your-openai-key-8
OPENAI_API_KEY_9=your-openai-key-9
OPENAI_MODEL=gpt-4o

# ── Ollama (local) ──
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── RAG Service ──
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE=chroma
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── Paths ──
PROJECTS_DIR=../PROJECTS
